# ============================================================
# ADAU1979 FPGA 板 PCB 工程 —— Git 忽略规则
#
# 原则：完整保存 Altium Designer 设计资产（原理图、PCB、封装库、
#       History 版本快照、工程日志与 DRC 输出）；
#       仅排除操作系统、编辑器垃圾文件与可再生的预览缓存。
# ============================================================

# ---------- 操作系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.vs/
.vscode/
.idea/
*.swp
*~

# ---------- Altium 预览缓存（可由工程重新导出） ----------
__Previews/

# ---------- 编辑器临时与锁文件 ----------
~$*
*.tmp
*.~lock*
__pycache__/
*.py[cod]

# ---------- Python 虚拟环境（辅助脚本用） ----------
.venv/
venv/
.pytest_cache/

# ---------- 凭据与本地文件 ----------
.env
.env.*
*.pem
*.key
